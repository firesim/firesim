#!/bin/bash

# Remove the FireSim shared-memory files in /dev/shm whose names contain TAG, the
# run tag FireSim names a run's shmem ports with, leaving other runs' files alone.
# With --pipes, also remove FireAxe's pipe files, which aren't named with a tag.
# Usage: firesim-remove-dev-shm TAG [--pipes]

set -ex

if [[ $# -lt 1 || $# -gt 2 || ! "$1" =~ ^[A-Za-z0-9_]+$ || ( $# -eq 2 && "$2" != --pipes ) ]]; then
    echo "Usage: $0 TAG [--pipes] (TAG: letters, digits and underscores only)" >&2
    exit 1
fi

rm -f /dev/shm/*"$1"*
if [[ $# -eq 2 ]]; then
    rm -f /dev/shm/pipe_h2t* /dev/shm/pipe_t2h*
fi
