# V80 DDR4 Channel 1 (RDIMM) pin constraints
# Adapted from AVED impl.pins.xdc for FireSim ddr4_sdram_c0 interface
# Physical pins map to V80 DDR4 RDIMM channel (Banks 703/704/705)

# DDR4 reference clock (Channel 1)
set_property -dict { PACKAGE_PIN CB15    IOSTANDARD LVDS15                            } [get_ports "sys_clk0_1_clk_p"]

# Command/Address
set_property -dict { PACKAGE_PIN CG22    IOSTANDARD SSTL12                            } [get_ports "ddr4_sdram_c0_act_n"]
set_property -dict { PACKAGE_PIN CH20    IOSTANDARD SSTL12                            } [get_ports "ddr4_sdram_c0_adr[0]"]
