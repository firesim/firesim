diff --git a/linker/slashkit/emit/hw/project_gen.py b/linker/slashkit/emit/hw/project_gen.py
index 0c7ff7d..b44d1dd 100644
--- a/linker/slashkit/emit/hw/project_gen.py
+++ b/linker/slashkit/emit/hw/project_gen.py
@@ -151,9 +151,16 @@ def _environment_with_udev_ld_preload() -> Dict[str, str]:
     possible_paths = [
         Path("/lib/x86_64-linux-gnu/libudev.so.1"), Path("/lib64/libudev.so.1")]
     existing_paths = [str(path) for path in possible_paths if path.is_file()]
+    # On Ubuntu 24.04 libudev.so.1 gained a dependency on libcap.so.2 which
+    # the DDRMC firmware compiler bundled with Vivado cannot resolve, so the
+    # calibration ELF is silently never built (Xilinx/SLASH#139). Preload the
+    # dependency alongside libudev.
+    dep_paths = [
+        Path("/lib/x86_64-linux-gnu/libcap.so.2"), Path("/lib64/libcap.so.2")]
+    existing_deps = [str(path) for path in dep_paths if path.is_file()]
     env = dict(os.environ)
     if len(existing_paths) > 0:
-        env["LD_PRELOAD"] = ":".join(existing_paths)
+        env["LD_PRELOAD"] = ":".join(existing_paths + existing_deps)
     return env
 
 
